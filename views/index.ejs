  <main>
    <section class="work">
      <div class="container">
        <h2 class="h2" id="work">Projects</h2>
        <div class="work-boxes">
          <div class="work-box">
            <div class="work-textbox">
              <h3 class="h3">I Heal</h3>
              <p class="work-text">
                I Heal is a Hospital Management System that manages patient records and offers services like ambulance
                booking,
                doctor consultations, and medicine discussions
              </p>
              <ol class="work-technologies">
                <li>Angular</li>
                <li>Node.js</li>
                <li>Express</li>
                <li>MySql</li>
                <li>Bootstrap</li>
              </ol>
              <div class="work-links">
                <a href="https://maishahealthai.co.zw/home" target="_blank" rel="noopener" class="link">Explore this
                  project</a>
              </div>
            </div>
            <picture class="work-img">
              <img loading="lazy" src="assets/images/work/iHeal.png" alt="agency elevation" />
            </picture>
          </div>
          <div class="work-box">
            <div class="work-textbox">
              <h3 class="h3">Game Box</h3>
              <p class="work-text">Game Box is a gaming platform that hosts tournaments, tracks player scores, and
                distributes rewards based on rankings</p>
              <ol class="work-technologies">
                <li>Angular</li>
                <li>MySql</li>
                <li>Node</li>
                <li>Tailwind</li>
                <li>Express</li>
              </ol>
              <div class="work-links">
                <a href="https://yogamez.co.zw/" target="_blank" rel="noopener" class="link">Explore this project</a>
              </div>
            </div>
            <picture class="work-img">
              <img loading="lazy" src="assets/images/work/gamebox.png" alt="portfolio template" />
            </picture>
          </div>
          <div class="work-box">
            <div class="work-textbox">
              <h3 class="h3">Spotify Clone</h3>
              <p class="work-text">
                Website for listening the Music
              </p>
              <ol class="work-technologies">
                <li>React</li>
                <li>Node</li>
                <li>Express</li>
                <li>TailWind</li>
                <li>MongoDb</li>
              </ol>
              <div class="work-links">
                <a href="https://ecommerce-frontend-eight-xi.vercel.app" target="_blank" rel="noopener"
                  class="link">Explore this project</a>
                <a href="#" target="_blank" rel="noopener" title="Source code">
                  <img src="assets/images/social-links/github.svg" alt="GitHub" loading="lazy" />
                </a>
              </div>
            </div>
            <picture class="work-img">
              <img loading="lazy"
                src="https://images.unsplash.com/photo-1514471157964-06459a4b9241?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                alt="contribute dev" />
            </picture>
          </div>
        </div>
      </div>
    </section>
    <section class="skills">
      <div class="container">
        <h2 class="h2" id="skills">My Toolkit</h2>
        <div class="skills-imgs">
          <img src="assets/images/skills/angular.jfif" alt="Saas" class="skills-img" loading="lazy" title="Saas">
          <img src="assets/images/skills/jira.jfif" alt="Saas" class="skills-img" loading="lazy" title="Saas">
          <img src="assets/images/skills/html.png" alt="Html" class="skills-img" loading="lazy" title="Html">
          <img src="assets/images/skills/css-3.png" alt="Css" class="skills-img" loading="lazy" title="Css">
          <img src="assets/images/skills/js.png" alt="Typescript" class="skills-img" loading="lazy" title="JavaScript">
          <img src="assets/images/skills/bootstrap.png" alt="bootstrap" class="skills-img" loading="lazy"
            title="Web bootstrap">
          <img src="assets/images/skills/tailwind.svg" alt="Tailwind" class="skills-img" loading="lazy"
            title="Tailwind">
          <img src="assets/images/skills/materialui.png" alt="Material UI" class="skills-img" loading="lazy"
