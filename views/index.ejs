  <header class="header">
    <div class="menu-btn-container">
      <div class="container">
        <button type="button" class="menu-btn">menu</button>
      </div>
    </div>
    <nav class="nav hidden">
      <ol class="nav-items">
        <li class="nav-item"><a href="#">Home</a></li>
        <li class="nav-item"><a href="#work">Projects</a></li>
        <li class="nav-item"><a href="#skills">My Skills</a></li>
        <li class="nav-item">
          <a href="#contact" data-focused="last-focused">Contact</a>
        </li>
      </ol>
    </nav>
    <div class="container">
      <div class="header-textbox">
        <h1 class="h1">
          <span>Hi, I'm Naved Ali Khan</span>
          <span>Full Stack Web Developer</span>
        </h1>
        <p class="header-text">
          Software developer with 1 year of experience in Angular, Node.js, and SQL. Strong MERN background with
          expertise in
          building scalable web applications, RESTful APIs, and responsive UIs using modern frontend frameworks,
          databases,
          and third-party integrations.
        </p>
        <div class="header-btns">
          <a href="#contact" class="btn btn-cta">Hire me</a>
          <a href="#work" class="btn btn-secondary">See my work</a>
        </div>
      </div>
    </div>
