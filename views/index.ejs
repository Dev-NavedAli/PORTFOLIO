          <img src="assets/images/skills/react.webp" alt=" React" class="skills-img" loading="lazy" title=" React">
          <img src="assets/images/skills/redux.png" alt="Redux" class="skills-img" loading="lazy" title="Redux">
          <img src="assets/images/skills/Git_icon.svg" alt="Git" class="skills-img" loading="lazy" title="Git">
          <img src="assets/images/skills/github-sign.png" alt="Github" class="skills-img" loading="lazy" title="Github"
            style="background-color: white;">
          <img src="assets/images/skills/sql.png" alt="Sql" class="skills-img" loading="lazy" title="Sql">
          <img src="assets/images/skills/mongodb.svg" alt="MongoDb" class="skills-img" loading="lazy" title="MongoDb">
          <img src="assets/images/skills/node-js.svg" alt="Node" class="skills-img" loading="lazy" title="Node">
          <img src="assets/images/skills/express.svg" alt="Express" class="skills-img" loading="lazy" title="Express"
            style="background-color: white;">
          <img src="assets/images/skills/python.svg" alt="Python" class="skills-img" loading="lazy" title="Python">
          <img src="assets/images/skills/django.svg" alt="Djnago" class="skills-img" loading="lazy" title="Djnago">
          <img src="assets/images/skills/bitbucket.jfif" alt="Saas" class="skills-img" loading="lazy" title="Saas">
          </figure>
        </div>
      </div>
    </section>
    <section class="contact">
      <div class="container">
        <h2 class="h2" id="contact">Send Message</h2>
        <div class="contact-content">
          <div class="contact-textbox">
            <strong href="#" class="hire-alert">
              <span class="indicator"></span>
              <a href="https://www.linkedin.com/in/naved-khan-294519252/" class="hirea">Available for hire</a>
            </strong>
            <p class="contact-text">
              Software developer with 1 year of experience in Angular, Node.js, and SQL. Strong MERN background with
              expertise in
              building scalable web applications, RESTful APIs, and responsive UIs using modern frontend frameworks,
              databases,
              and third-party integrations
            </p>
            <p class="contact-text">
              I'm also a freelancer
            </p>
            <img src="assets/images/signature.png" alt="Syed Mohsin" class="signatures" loading="lazy" />
          </div>
          <form action="/send-email" class="contact-form" method="POST">
            <div class="form-field">
              <label for="name">Name</label>
              <input type="text" name="name" id="name" required />
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input type="email" name="email" id="email" required inputmode="email" />
            </div>
            <div class="form-field">
              <label for="message">How can I help you?</label>
              <textarea name="message" id="message" required></textarea>
            </div>
            <button type="submit" class="btn btn-cta" onclick="toast">Send</button>
          </form>
        </div>
      </div>
    </section>
